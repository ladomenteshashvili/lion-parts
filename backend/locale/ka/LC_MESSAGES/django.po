#: parts/admin.py:54
msgid "Request"
msgstr "მოთხოვნა"

#: parts/admin.py:55
msgid "Offer"
msgstr "შეთავაზება"

#: parts/admin.py:57
msgid "Operator price"
msgstr "ოპერატორის ფასი"

#: parts/admin.py:58
msgid "Enter the weight (and the supplier price for a manual request), then run the “price ready” action: the price is calculated for the customer automatically."
msgstr "შეიყვანეთ წონა (ხელით მოთხოვნისას — მომწოდებლის ფასიც), შემდეგ გაუშვით მოქმედება „ფასი მზადაა“: ფასი მომხმარებლისთვის ავტომატურად დაითვლება."

#: parts/admin.py:62
msgid "Price snapshot"
msgstr "ფასის ჩანაწერი"

#: parts/admin.py:64 parts/admin.py:68
msgid "Customer link"
msgstr "მომხმარებლის ბმული"

#: parts/admin.py:75
msgid "Price ready: calculate the price and create the customer link"
msgstr "ფასი მზადაა: ფასის დათვლა და მომხმარებლის ბმულის შექმნა"

#: parts/admin.py:90
#, python-format
msgid "%(n)d request priced; its customer link is active."
