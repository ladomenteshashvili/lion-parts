#: accounts/models.py:38
msgid "Make another tariff the default first."
msgstr "Сначала сделайте другой тариф тарифом по умолчанию."

#: accounts/models.py:40
msgid "The default tariff needs a markup."
msgstr "Тарифу по умолчанию нужна наценка."

#: accounts/otp.py:19
#, python-brace-format
msgid "Lion Parts code: {code}"
msgstr "Код Lion Parts: {code}"

#: accounts/serializers.py:16 api/errors.py:23
msgid "This email is already linked to another account."
msgstr "Этот адрес эл. почты уже привязан к другому аккаунту."

#: accounts/serializers.py:17
msgid "This phone number is already linked to another account."
msgstr "Этот номер телефона уже привязан к другому аккаунту."

#: accounts/serializers.py:18
msgid "An account with this personal ID already exists."
msgstr "Аккаунт с этим личным номером уже существует."

#: accounts/serializers.py:19
msgid "A company with this identification code is already registered."
msgstr "Компания с этим идентификационным кодом уже зарегистрирована."

#: accounts/serializers.py:68
msgid "You must accept the terms to register."
msgstr "Для регистрации необходимо принять условия."

#: accounts/serializers.py:88 accounts/serializers.py:209
msgid "Choose one of the supported languages."
msgstr "Выберите один из поддерживаемых языков."

#: accounts/serializers.py:219 accounts/serializers.py:240
msgid "The current password is incorrect."
msgstr "Текущий пароль неверен."

#: accounts/validators.py:19
msgid "Enter a valid Georgian mobile number."
msgstr "Введите корректный грузинский номер мобильного телефона."

#: accounts/validators.py:25
msgid "The personal ID must have 11 digits."
msgstr "Личный номер должен состоять из 11 цифр."

#: accounts/validators.py:30
msgid "The company ID must have 9 digits."
msgstr "Идентификационный код компании должен состоять из 9 цифр."

#: accounts/validators.py:37
msgid "Enter a valid 17-character VIN."
msgstr "Введите корректный VIN из 17 символов."

#: accounts/validators.py:50
msgid "The password must contain an uppercase letter."
msgstr "Пароль должен содержать заглавную букву."

#: accounts/validators.py:51
msgid "The password must contain a lowercase letter."
msgstr "Пароль должен содержать строчную букву."

#: accounts/validators.py:52
msgid "The password must contain a digit."
msgstr "Пароль должен содержать цифру."

#: accounts/validators.py:54
msgid "The password must contain a symbol."
msgstr "Пароль должен содержать символ."

#: accounts/validators.py:64
msgid "Use upper- and lower-case letters, a digit and a symbol."
msgstr "Используйте заглавные и строчные буквы, цифру и символ."

#: accounts/views.py:121
msgid "If the account exists, a reset link has been sent."
msgstr "Если аккаунт существует, ссылка для сброса отправлена."

#: accounts/views.py:122
msgid "Password changed."
msgstr "Пароль изменён."

#: api/admin_i18n.py:38
msgid "The default-language value is required."
msgstr "Значение на основном языке обязательно."

#: api/drf_messages.py:8
msgid "This field is required."
msgstr "Обязательное поле."

#: api/drf_messages.py:9
msgid "This field may not be null."
msgstr "Это поле не может быть пустым."

#: api/drf_messages.py:10
msgid "This field may not be blank."
msgstr "Это поле не может быть пустым."

#: api/drf_messages.py:11
msgid "Not a valid string."
msgstr "Некорректная строка."

#: api/drf_messages.py:12
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr "Убедитесь, что это значение содержит не более {max_length} символов."

#: api/drf_messages.py:13
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Убедитесь, что это значение содержит не менее {min_length} символов."

#: api/drf_messages.py:14
#, python-brace-format
msgid "\"{input}\" is not a valid choice."
msgstr "Значения {input} нет среди допустимых вариантов."

#: api/drf_messages.py:15
msgid "Must be a valid boolean."
msgstr "Значение должно быть логическим (true или false)."

#: api/drf_messages.py:16
msgid "A valid integer is required."
msgstr "Введите правильное число."

#: api/drf_messages.py:17
msgid "A valid number is required."
msgstr "Требуется численное значение."

#: api/drf_messages.py:18
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Убедитесь, что это значение меньше либо равно {max_value}."

#: api/drf_messages.py:19
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Убедитесь, что это значение больше либо равно {min_value}."

#: api/drf_messages.py:20
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Убедитесь, что вы ввели не более {max_digits} цифры."

#: api/drf_messages.py:21
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Убедитесь, что вы ввели не более {max_decimal_places} цифры после запятой."

#: api/drf_messages.py:22
#, python-brace-format
msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Ожидался list со значениями, но был получен \"{input_type}\"."

#: api/drf_messages.py:23
msgid "This list may not be empty."
msgstr "Этот список не может быть пустым."

#: api/drf_messages.py:24
#, python-brace-format
msgid "Expected a dictionary of items but got type \"{input_type}\"."
msgstr "Ожидался словарь со значениями, но был получен \"{input_type}\"."

#: api/drf_messages.py:25
#, python-brace-format
msgid "Invalid data. Expected a dictionary, but got {datatype}."
msgstr "Недопустимые данные. Ожидался dictionary, но был получен {datatype}."

#: api/errors.py:7
msgid "Please check the highlighted fields."
msgstr "Проверьте заполненные поля."

#: api/errors.py:8
msgid "Incorrect email or password."
msgstr "Неверный адрес эл. почты или пароль."

#: api/errors.py:9
msgid "The code is incorrect."
msgstr "Неверный код."

#: api/errors.py:10
msgid "The code has expired. Request a new one."
msgstr "Срок действия кода истёк. Запросите новый код."

#: api/errors.py:11
msgid "Too many attempts. You can request a new code later."
msgstr "Превышено число попыток. Новый код можно будет запросить позже."

#: api/errors.py:12
msgid "Your registration session has expired. Please fill in the form again."
msgstr "Время регистрации истекло. Заполните форму заново."

#: api/errors.py:13
msgid "This link is no longer valid."
msgstr "Ссылка больше не действительна."

#: api/errors.py:14
msgid "Invalid callback."
msgstr "Некорректный callback."

#: api/errors.py:15
msgid "Please sign in."
msgstr "Пожалуйста, войдите в аккаунт."

#: api/errors.py:16
msgid "Security check failed. Please refresh the page."
msgstr "Проверка безопасности не пройдена. Обновите страницу."

#: api/errors.py:17
msgid "Phone and email must be verified before payment."
msgstr "Перед оплатой необходимо подтвердить телефон и эл. почту."

#: api/errors.py:18
msgid "Phone verification is required."
msgstr "Необходимо подтвердить телефон."

#: api/errors.py:19
msgid "Weight entry is not available for your account."
msgstr "Указание веса недоступно для вашего аккаунта."

#: api/errors.py:20
msgid "Price requests are not available for your account."
msgstr "Запрос цены недоступен для вашего аккаунта."

#: api/errors.py:21
msgid "This action is not allowed."
msgstr "Действие не разрешено."

#: api/errors.py:22
msgid "Not found."
msgstr "Не найдено."

#: api/errors.py:24
msgid "Email is already verified."
msgstr "Эл. почта уже подтверждена."

#: api/errors.py:25
msgid "You can't request a new code yet."
msgstr "Запросить новый код пока нельзя."

#: api/errors.py:26
msgid "The price has expired. Refresh to get the current price."
msgstr "Срок действия цены истёк. Обновите, чтобы получить актуальную цену."

#: api/errors.py:27
msgid "The price for this part is still being checked."
msgstr "Цена на эту деталь ещё уточняется."

#: api/errors.py:28
msgid "Your cart is empty."
msgstr "Корзина пуста."

#: api/errors.py:29
msgid "Checkout is blocked: an item in your cart has an expired price or is unavailable."
msgstr "Оформление заблокировано: в корзине есть товар с истёкшей ценой или недоступный товар."

#: api/errors.py:30
msgid "No action is required anymore."
msgstr "Действие больше не требуется."

#: api/errors.py:31
msgid "The order can no longer be cancelled: a part has already been purchased."
msgstr "Заказ больше нельзя отменить: деталь уже закуплена."

#: api/errors.py:32
msgid "There is nothing to pay."
msgstr "Нет суммы к оплате."

#: api/errors.py:33
msgid "A payment is already in progress."
msgstr "Оплата уже выполняется."

#: api/errors.py:34
msgid "You can delete your account once your active orders are completed."
msgstr "Аккаунт можно удалить после завершения активных заказов."

#: api/errors.py:35
msgid "Too many attempts. Please try again later."
msgstr "Слишком много попыток. Попробуйте позже."

#: api/errors.py:36 api/errors.py:37
msgid "The service is temporarily unavailable. Please try again in a few minutes."
msgstr "Сервис временно недоступен. Повторите попытку через несколько минут."

#: api/errors.py:38
msgid "The SMS could not be sent. Please try again."
msgstr "Не удалось отправить SMS. Попробуйте ещё раз."

#: api/errors.py:39
msgid "The payment page could not be opened. You were not charged — please try again."
msgstr "Не удалось открыть страницу оплаты. Деньги не списаны — попробуйте ещё раз."

#: api/errors.py:41
msgid "Something went wrong. Please try again later."
msgstr "Что-то пошло не так. Попробуйте позже."

#: api/exceptions.py:19
msgid "Method not allowed."
msgstr "Метод не разрешён."

#: api/exceptions.py:20
msgid "Malformed request."
msgstr "Некорректный запрос."

#: api/mail.py:15
msgid "Confirm your email address"
msgstr "Подтвердите адрес электронной почты"

#: api/mail.py:16
msgid "Reset your password"
msgstr "Сброс пароля"

#: api/mail.py:17
msgid "Confirm your new email address"
msgstr "Подтвердите новый адрес электронной почты"

#: api/mail.py:18
msgid "Your email address was changed"
msgstr "Ваш адрес электронной почты изменён"

#: api/templates/emails/email_change_confirm.html:2
#: api/templates/emails/email_change_confirm.txt:1
#: api/templates/emails/email_changed_notice.html:2
#: api/templates/emails/email_changed_notice.txt:1
#: api/templates/emails/password_reset.html:2
#: api/templates/emails/password_reset.txt:1
#: api/templates/emails/verify_email.html:2
#: api/templates/emails/verify_email.txt:1
#, python-format
msgid "Hello, %(name)s!"
msgstr "Здравствуйте, %(name)s!"

#: api/templates/emails/email_change_confirm.html:3
#: api/templates/emails/email_change_confirm.txt:3
msgid "To use this address for your Lion Parts account, open this link:"
msgstr "Чтобы использовать этот адрес для аккаунта Lion Parts, откройте ссылку:"

#: api/templates/emails/email_change_confirm.html:5
#: api/templates/emails/email_change_confirm.txt:6
msgid "The link is valid for 48 hours. Until you confirm, your old address stays active."
msgstr "Ссылка действительна 48 часов. До подтверждения старый адрес остаётся активным."

#: api/templates/emails/email_changed_notice.html:3
#: api/templates/emails/email_changed_notice.txt:3
#, python-format
msgid "The email address of your Lion Parts account was changed to %(new_email)s."
msgstr "Адрес электронной почты вашего аккаунта Lion Parts изменён на %(new_email)s."

#: api/templates/emails/email_changed_notice.html:4
#: api/templates/emails/email_changed_notice.txt:5
msgid "If you didn't make this change, contact Lion Parts support right away."
msgstr "Если вы не вносили это изменение, сразу свяжитесь со службой поддержки Lion Parts."

#: api/templates/emails/password_reset.html:3
#: api/templates/emails/password_reset.txt:3
msgid "To set a new password, open this link:"
msgstr "Чтобы задать новый пароль, откройте ссылку:"

#: api/templates/emails/password_reset.html:5
#: api/templates/emails/password_reset.txt:6
msgid "The link is valid for 1 hour and works once. If you didn't ask to reset your password, ignore this email."
msgstr "Ссылка действительна 1 час и работает один раз. Если вы не запрашивали сброс пароля, проигнорируйте это письмо."

#: api/templates/emails/verify_email.html:3
#: api/templates/emails/verify_email.txt:3
msgid "Please confirm your email address by opening this link:"
msgstr "Подтвердите адрес электронной почты, открыв ссылку:"

#: api/templates/emails/verify_email.html:5
#: api/templates/emails/verify_email.txt:6
msgid "The link is valid for 48 hours. If you didn't create a Lion Parts account, ignore this email."
msgstr "Ссылка действительна 48 часов. Если вы не создавали аккаунт Lion Parts, проигнорируйте это письмо."

#: cart/serializers.py:18 cart/services.py:47
msgid "The quantity must be between 1 and 99."
msgstr "Количество должно быть от 1 до 99."

#: config/settings.py:124
msgid "Georgian"
msgstr "Грузинский"

#: config/settings.py:124
msgid "English"
msgstr "Английский"

