# Lion Parts backend — environment template (G§12).
# Copy to backend/.env and fill in real values privately. Never commit .env.
# Every variable read by config/settings.py is listed here; placeholders only.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Fallback language (must be in LANGUAGES); read once LP-BE-1301 lands.
DEFAULT_LANGUAGE=ka

# --- PostgreSQL (development DB: lion_parts_v2 only) ---
DB_NAME=lion_parts_v2
DB_USER=lion_parts_dev
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Frontend, CSRF, CORS, cookies, HTTPS ---
FRONTEND_BASE_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Option B (subdomains) only; empty for same origin.
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SAMESITE=Lax
# e.g. .lionparts.ge for option B; leave unset otherwise.
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
# Defaults to (not DEBUG). Set explicitly only to override.
# SECURE_SSL_REDIRECT=True
ADMIN_URL_PATH=admin/
# Defaults to backend/media. Production: e.g. /srv/lionparts/media (back it up with the DB).
# MEDIA_ROOT=

# --- Parts supplier (AMT) ---
PARTS_PROVIDER=demo
AMT_ENDPOINT=https://automototrade.com/wsdl/server.php
AMT_API_LOGIN=
AMT_API_PASSWORD=
AMT_VERIFY_SSL=True
AMT_TIMEOUT_SECONDS=15

# --- Exchange rates ---
NBG_RATES_URL=https://nbg.gov.ge/gw/api/ct/monetarypolicy/currencies/en/json/?currencies=USD

# --- SMS (Sender.ge) ---
SENDER_GE_ENABLED=False
SENDER_GE_API_KEY=
SENDER_GE_SEND_URL=https://sender.ge/api/send.php
SENDER_GE_SMSNO=2
SENDER_GE_PRIORITY=0
SMS_DEMO_MODE=False

# --- Email (mapped onto Django 6.1 MAILERS["default"]) ---
# Production/staging: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Lion Parts <no-reply@lionparts.ge>

# --- Payments ---
PAYMENT_PROVIDER=fake
# Used only by the separately delivered Flitt adapter.
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# --- Demo / staging switches (never True in production) ---
ENABLE_DEMO_ENDPOINTS=False

# --- Phone verification ---
PHONE_VERIFICATION_CODE_TTL_MINUTES=5
PHONE_VERIFICATION_RESEND_SECONDS=60
PHONE_VERIFICATION_MAX_ATTEMPTS=5

# --- Legacy pricing (removed in LP-BE-302 / LP-BE-303) ---
KURSI_PUBLIC_CURRENCIES_URL=https://api-core.kursi.ge/api/public/currencies
DEFAULT_SHIPPING_USD_PER_KG=8.00
DEFAULT_CUSTOMER_MARKUP_PERCENT=20.00
VAT_MULTIPLIER=1.18
DEFAULT_ETA_DAYS=14

# --- Legacy invoice texts (moved to SiteSettings in LP-BE-604) ---
INVOICE_SELLER_NAME=Lion Parts
INVOICE_SELLER_IDENTIFICATION_CODE=
INVOICE_SELLER_ADDRESS=Tbilisi, Georgia
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_BANK_DETAILS=
INVOICE_FOOTER_TEXT=This invoice was generated from Lion Parts admin order data.
INVOICE_DOCUMENT_TITLE=INVOICE
INVOICE_DOCUMENT_SUBTITLE=
INVOICE_SHOW_DRAFT_WATERMARK=False
INVOICE_DRAFT_WATERMARK_TEXT=DRAFT
INVOICE_NUMBER_PREFIX=INV
INVOICE_PAYMENT_DUE_TEXT=Payment due upon receipt.
INVOICE_AMOUNT_NOTE=All amounts are in GEL and include VAT unless otherwise noted.
INVOICE_SHOW_PAYMENT_BADGE=True
