# Isolated Lion Parts staging (docs/staging-runbook.md). Placeholders only: never commit the real file.
# Install as /home/lionparts-stage/lion-parts/backend/.env, owner lionparts-stage, mode 600.
# provision.sh fills SECRET_KEY and DB_PASSWORD; replace STAGE_HOST and FRONTEND_ORIGIN.
SECRET_KEY=
DEPLOY_ENV=staging
DEBUG=False
ALLOWED_HOSTS=STAGE_HOST
DEFAULT_LANGUAGE=ka
LOG_LEVEL=INFO
ADMIN_URL_PATH=stage-admin/

# New, empty database only. stage.sh refuses any other name.
DB_NAME=lp_stage_v1
DB_USER=lp_stage
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

FRONTEND_BASE_URL=https://FRONTEND_ORIGIN
CSRF_TRUSTED_ORIGINS=https://FRONTEND_ORIGIN
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SAMESITE=Lax
# One proxy (nginx) in front of gunicorn. With 0 every client shares one rate-limit bucket.
NUM_PROXIES=1
MEDIA_ROOT=/home/lionparts-stage/media

# Demo supplier, fake payments, demo OTP: nothing real is called or charged.
PARTS_PROVIDER=demo
AMT_API_LOGIN=
AMT_API_PASSWORD=
AMT_LOOKUP_BUDGET_SECONDS=30
PAYMENT_PROVIDER=fake
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
SENDER_GE_ENABLED=False
SENDER_GE_API_KEY=
SMS_DEMO_MODE=True
ENABLE_DEMO_ENDPOINTS=True

# Mailpit catches every email; nothing leaves the server.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="Lion Parts Staging <no-reply@example.invalid>"
EMAIL_REPLY_TO=support-staging@example.invalid
