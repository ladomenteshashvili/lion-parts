[Unit]
Description=Mailpit for the isolated Lion Parts staging (loopback only)
After=network.target

[Service]
User=lionparts-stage
Group=lionparts-stage
ExecStart=/usr/local/bin/mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025 --max 1000 --database /home/lionparts-stage/mailpit.db
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=200M

[Install]
WantedBy=multi-user.target
